{
  "name": "dochain",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "start:api": "nx serve api",
    "start:patient": "nx run @dochain/web-patient:dev",
    "start:doctor": "nx run @dochain/web-doctor:dev",
    "start:admin": "nx run @dochain/web-admin:dev",
    "build:all": "nx run-many --target=build --all",
    "test:all": "nx run-many --target=test --all",
    "lint:all": "nx run-many --target=lint --all",
    "db:migrate": "nx run database:migrate",
    "db:seed": "nx run api:seed",
    "build:api": "npm run build --workspace=@dochain/api",
    "start:api:prod": "npm run start --workspace=@dochain/api"
  },
  "engines": {
    "node": "20.x"
  },
  "private": true,
  "devDependencies": {
    "@nx/eslint": "^19.0.0",
    "@nx/jest": "^19.0.0",
    "@nx/js": "^19.0.0",
    "@nx/nest": "^19.0.0",
    "@nx/next": "^19.0.0",
    "@nx/workspace": "^19.0.0",
    "@types/node": "^20.0.0",
    "nx": "^19.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "^0.2.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.6.0",
    "typeorm": "^0.3.28"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ]
}
