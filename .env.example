# API (apps/api)
PORT=4000
# Email: Render free tier blocks SMTP (ports 25/465/587). Use Resend + HTTPS instead of Gmail SMTP:
# RESEND_API_KEY=re_xxxx
# SMTP_FROM=onboarding@resend.dev

# Database — hosted Postgres (e.g. Neon) needs SSL; set DB_SSL=true when NODE_ENV is not production
# DB_HOST=
# DB_PORT=5432
# DB_USERNAME=
# DB_PASSWORD=
# DB_NAME=
# DB_SSL=true
# DB_SYNC=true
# DB_LOGGING=false
WEB_ORIGIN=
# When WEB_ORIGIN is unset, CORS uses these (scheme + host + port only; no path):
PATIENT_APP_URL=http://localhost:3001
# Must match the doctor Next app URL (includes `/doctor` when using default basePath). Wrong value = broken email links (404 on verify).
DOCTOR_APP_URL=http://localhost:3002/doctor
ADMIN_APP_URL=http://localhost:3003
# If the doctor app is deployed at site root (NEXT_PUBLIC_STANDALONE_DEPLOY=true on web-doctor), set the public origin and:
# DOCTOR_APP_STANDALONE_DEPLOY=true

# Cloudinary (doctor profile images, prescription PDFs, chat attachments)
# CLOUDINARY_CLOUD_NAME=dfnehgei2
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Next apps — use one public API URL in production
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Patient app — doctor portal link prefix (include /doctor in production)
NEXT_PUBLIC_DOCTOR_APP_URL=http://localhost:3002/doctor

# Optional: `npm run db:seed` (creates admin if missing)
# ADMIN_SEED_EMAIL=admin@dochain.in
# ADMIN_SEED_PASSWORD=Admin@123456
