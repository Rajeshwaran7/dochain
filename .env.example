# API (apps/api)
PORT=4000
WEB_ORIGIN=
# When WEB_ORIGIN is unset, CORS uses these (scheme + host + port only; no path):
PATIENT_APP_URL=http://localhost:3001
DOCTOR_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3003
# Email links for doctor flows must include /doctor base path:
# DOCTOR_APP_URL=http://localhost:3002/doctor

# Next apps — use one public API URL in production
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Patient app — doctor portal link prefix (include /doctor in production)
NEXT_PUBLIC_DOCTOR_APP_URL=http://localhost:3002/doctor

# Optional: `npm run db:seed` (creates admin if missing)
# ADMIN_SEED_EMAIL=admin@dochain.in
# ADMIN_SEED_PASSWORD=Admin@123456
