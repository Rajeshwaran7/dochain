{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2017",
    "lib": ["es2017"],
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "paths": {
      "@dochain/database": ["../../libs/database/src"],
      "@dochain/utils": ["../../libs/utils/src"],
      "@dochain/auth": ["../../libs/auth/src"],
      "@dochain/validation": ["../../libs/validation/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
