# Copy to `.env.local` in this folder (Next.js loads it automatically).

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── basePath / URLs ─────────────────────────────────────────────────────────
# Leave UNSET or `false` for normal local dev:
#   App URL: http://localhost:3002/doctor  (assets at /doctor/_next/...)
#
# Set to `true` only for a standalone deploy where this app is the site root
# (no /doctor prefix). Then use http://localhost:3002/auth/login — NOT /doctor/.
# If STANDALONE=true but you still open /doctor/..., you will see 404s for
# /doctor/_next/static/... because Next serves chunks at /_next/... instead.
NEXT_PUBLIC_STANDALONE_DEPLOY=
